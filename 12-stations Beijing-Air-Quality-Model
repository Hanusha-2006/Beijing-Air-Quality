        'learning_rate': [0.01, 0.05, 0.1]
    }
    base_model = GradientBoostingRegressor(random_state=42)
    
elif best_model_name == 'Ridge Regression':
    param_grid = {'alpha': [0.001, 0.01, 0.1, 1.0, 10.0, 100.0]}
    base_model = Ridge()
    
elif best_model_name == 'Lasso Regression':
    param_grid = {'alpha': [0.001, 0.01, 0.1, 1.0, 10.0]}
    base_model = Lasso(max_iter=5000)
    
elif best_model_name == 'Decision Tree':
    param_grid = {
        'max_depth': [10, 15, 20, 25],
        'min_samples_split': [2, 5, 10]
    }
    base_model = DecisionTreeRegressor(random_state=42)
    
else:
    param_grid = {}
    base_model = trained_models[best_model_name]

if param_grid:
    grid_search = GridSearchCV(base_model, param_grid, cv=5, 
                               scoring='neg_mean_squared_error', n_jobs=-1)
    grid_search.fit(X_train, y_train)
    
    best_model = grid_search.best_estimator_
    y_pred_opt = best_model.predict(X_test)
    
    opt_rmse = np.sqrt(mean_squared_error(y_test, y_pred_opt))
    opt_r2 = r2_score(y_test, y_pred_opt)
    opt_mae = mean_absolute_error(y_test, y_pred_opt)
    
    improvement = best_rmse - opt_rmse
    
    print(f"   Best params: {grid_search.best_params_}")
    print(f"   Optimized RMSE: {opt_rmse:.4f} (improvement: {improvement:.4f})")
    print(f"   Optimized R²: {opt_r2:.4f}")
    print(f"   Optimized MAE: {opt_mae:.4f}")
    
    # Use optimized model
    best_model_obj = best_model
    best_predictions = y_pred_opt
    final_rmse = opt_rmse
    final_r2 = opt_r2
    final_mae = opt_mae
else:
    best_model_obj = trained_models[best_model_name]
